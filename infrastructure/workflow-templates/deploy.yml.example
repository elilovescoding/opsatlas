# INERT TEMPLATE: copy into .github/workflows only after explicit deployment approval.
name: Manually approved AWS application deployment
on:
  workflow_dispatch:
    inputs:
      approval:
        description: 'Type DEPLOY OPSATLAS after reviewing AWS costs and this commit.'
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: aws-production
  cancel-in-progress: false
jobs:
  deploy:
    if: ${{ inputs.approval == 'DEPLOY OPSATLAS' && vars.AWS_DEPLOY_ENABLED == 'true' && github.ref == 'refs/heads/main' }}
    environment: aws-production
    runs-on: ubuntu-latest
    timeout-minutes: 25
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - name: Require deployment configuration
        env:
          ROLE: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          BUCKET: ${{ vars.AWS_RELEASE_BUCKET }}
          INSTANCE: ${{ vars.AWS_INSTANCE_ID }}
        run: test -n "$ROLE" && test -n "$BUCKET" && test -n "$INSTANCE"
      - run: |
          docker build --pull -t opsatlas-backend:${GITHUB_SHA} backend
          docker build --pull -t opsatlas-frontend:${GITHUB_SHA} frontend
          docker build --pull -t opsatlas-database:${GITHUB_SHA} infrastructure/database
          docker build --pull -t opsatlas-demo-targets:${GITHUB_SHA} infrastructure/demo-targets
          docker build --pull -t opsatlas-edge:${GITHUB_SHA} infrastructure/edge
          docker save "opsatlas-backend:$GITHUB_SHA" "opsatlas-frontend:$GITHUB_SHA" \
            "opsatlas-database:$GITHUB_SHA" "opsatlas-demo-targets:$GITHUB_SHA" \
            "opsatlas-edge:$GITHUB_SHA" | gzip > images.tar.gz
          tar czf bundle.tar.gz images.tar.gz docker-compose.yml docker-compose.cloud.yml scripts/demo-targets.mjs scripts/deploy.sh infrastructure/Caddyfile
          sha256sum bundle.tar.gz > bundle.sha256
      - uses: aws-actions/configure-aws-credentials@61815dcd50bd041e203e49132bacad1fd04d2708 # v5
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
      - name: Upload immutable release and deploy through SSM
        env:
          BUCKET: ${{ vars.AWS_RELEASE_BUCKET }}
          INSTANCE: ${{ vars.AWS_INSTANCE_ID }}
          AWS_REGION: ${{ vars.AWS_REGION }}
        shell: bash
        run: |
          [[ "$BUCKET" =~ ^[a-z0-9.-]+$ ]]
          [[ "$INSTANCE" =~ ^i-[a-f0-9]+$ ]]
          checksum=$(cut -d' ' -f1 bundle.sha256)
          aws s3api put-object --bucket "$BUCKET" --key "releases/$GITHUB_SHA/bundle.tar.gz" --body bundle.tar.gz --if-none-match '*' > /dev/null
          command="set -eu; install -d -m 700 /opt/opsatlas/releases/$GITHUB_SHA; cd /opt/opsatlas/releases/$GITHUB_SHA; aws s3 cp s3://$BUCKET/releases/$GITHUB_SHA/bundle.tar.gz bundle.tar.gz --only-show-errors; echo '$checksum  bundle.tar.gz' | sha256sum -c -; tar xzf bundle.tar.gz; bash scripts/deploy.sh $GITHUB_SHA"
          jq -n --arg command "$command" '{commands:[$command],executionTimeout:["900"]}' > /tmp/ssm-parameters.json
          command_id=$(aws ssm send-command --instance-ids "$INSTANCE" --document-name AWS-RunShellScript --parameters file:///tmp/ssm-parameters.json --query Command.CommandId --output text)
          for attempt in $(seq 1 90); do
            status=$(aws ssm get-command-invocation --command-id "$command_id" --instance-id "$INSTANCE" --query Status --output text 2>/dev/null || true)
            case "$status" in
              Success) echo 'Deployment health checks passed.'; exit 0 ;;
              Failed|Cancelled|TimedOut) aws ssm get-command-invocation --command-id "$command_id" --instance-id "$INSTANCE"; exit 1 ;;
            esac
            sleep 10
          done
          echo 'Timed out waiting for deployment.' >&2
          exit 1
